# dependencies
# NOTE: no trailing slash on purpose — a bare pattern also matches a *symlinked*
# node_modules (used when linting without a local install), which `node_modules/`
# (directories only) would leave untracked and vulnerable to `git add .`.
node_modules
.pnp
.pnp.js

# testing
coverage/

# next.js
.next/
out/

# production
build/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env
.env.*
!.env.example
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# same app
.same/
